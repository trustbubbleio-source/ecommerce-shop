enum CardRarity {
  common
  uncommon
  rare
  holo_rare          @map("holo-rare")
  ultra_rare         @map("ultra-rare")
  secret_rare        @map("secret-rare")
  illustration_rare  @map("illustration-rare")
}

enum CardCondition {
  mint
  near_mint          @map("near-mint")
  lightly_played     @map("lightly-played")
  moderately_played  @map("moderately-played")
}

enum ProductLanguage {
  english
  japanese
  chinese
}

model User {
  id              String    @id
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")
  /** Google subject (`sub`) when the user signed in with Google. */
  googleSub       String?   @unique @map("google_sub")
  role            String    @default("customer")
  /** Null until the user confirms via the registration email link (Google users are verified). */
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  orders          Order[]
  profile         Profile?
  favorites       Favorite[]
  reviews         ProductReview[]
  wantListItems   WantListItem[]

  @@map("users")
}

/** Extended account details (1:1 with User). Created when the user registers. */
model Profile {
  userId            String   @id @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  country           String?
  city              String?
  /** Short collector note shown on the account profile. */
  bio               String?
  /** Default shipping address (Address JSON). Prefills checkout. */
  shippingAddress   Json?    @map("shipping_address")
  /** Saved promo code applied automatically at checkout. */
  discountCode      String?  @map("discount_code")
  preferredCurrency String   @default("eur") @map("preferred_currency")
  marketingOptIn    Boolean  @default(false) @map("marketing_opt_in")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Product {
  id             String           @id
  slug           String           @unique
  name           String
  description    String
  category       ProductCategory
  setName        ProductSet         @map("set_name")
  series         ProductSeries
  price          Int
  compareAtPrice Int?               @map("compare_at_price")
  currency       String             @default("eur")
  image          String?
  images         String[]           @default([])
  accent         String
  stock          Int                @default(0)
  featured       Boolean            @default(false)
  isNew          Boolean            @default(false) @map("is_new")
  rating         Float              @default(0)
  reviewCount    Int                @default(0) @map("review_count")
  tags           String[]           @default([])
  rarity         CardRarity?
  condition      CardCondition?
  language       ProductLanguage  @default(english)
  cardNumber     String?            @map("card_number")
  /** Illustrator name for single cards (searchable). */
  artist         String?
  releaseDate    String             @map("release_date")
  favorites      Favorite[]
  reviews        ProductReview[]

  @@index([category])
  @@index([series])
  @@index([featured])
  @@map("products")
}

/** Verified buyer review + comment (one per user per product). */
model ProductReview {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  /** Star rating 1–5. */
  rating    Int
  /** Review comment body. */
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("product_reviews")
}

/** Per-user saved products (wishlist). */
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

/** Member sourcing request — what they want us to find / offer. */
model WantListItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /** Preset id from shared WANT_LIST_PRESETS. */
  preset    String
  title     String
  notes     String   @default("")
  /** pending | reviewing | accepted | rejected | found | contacted */
  status    String   @default("pending")
  adminNote String?  @map("admin_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("want_list_items")
}

model Order {
  id              String   @id
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  status          String   @default("pending")
  lines           Json
  subtotal        Int
  shipping        Int
  total           Int
  currency        String
  stripeSessionId String?  @unique @map("stripe_session_id")
  invoiceUrl      String?  @map("invoice_url")
  fulfillmentStep String?  @map("fulfillment_step")
  carrierName     String?  @map("carrier_name")
  trackingUrl     String?  @map("tracking_url")
  shippingAddress Json?    @map("shipping_address")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("orders")
}
