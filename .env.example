# ─────────────────────────────────────────────────────────────
# One More Rip — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) ---
# Transaction pooler — API runtime (port 6543, ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Session/direct pooler — Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=use-a-long-random-string-in-production

# PayPal REST credentials (Client ID + Secret from developer.paypal.com).
# Mapped as PAYPAL_API_KEY / PAYPAL_SECRET_KEY in this project.
PAYPAL_API_KEY=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_client_secret
# sandbox (default) or live — must match the credential environment
PAYPAL_MODE=live
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/cart
# Production only: set true to allow mock payments WITHOUT PayPal keys (prelaunch emergency).
# ALLOW_MOCK_PAYMENTS=false

# --- PayPal Zettle Inventory (POS ↔ web stock sync) ---
# Create a self-hosted app at https://developer.zettle.com
# Scopes: READ:PRODUCT, WRITE:PRODUCT
ZETTLE_CLIENT_ID=
ZETTLE_API_KEY=
# Optional — discoverable via GET /v3/inventories if omitted
# ZETTLE_STORE_INVENTORY_UUID=
# ZETTLE_SOLD_INVENTORY_UUID=
# Subscribe Pusher InventoryBalanceChanged → https://<api-host>/api/webhooks/zettle


# --- Email (Resend) ---
# Create a key at https://resend.com — must start with re_
# Without a real key the API runs in mock mode (logs emails to the console).
RESEND_API_KEY=re_xxx
# After you verify onemorerip.cards in Resend, switch FROM to your domain:
# EMAIL_FROM=One More Rip <noreply@onemorerip.cards>
EMAIL_FROM=One More Rip <onboarding@resend.dev>
EMAIL_CONTACT_INBOX=contact@onemorerip.cards
EMAIL_ORDERS_INBOX=order@onemorerip.cards

# --- Google Sign-In (optional) ---
# Create an OAuth Client ID (Web) in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 and your production domain.
# Use the same Client ID on API + web.
GOOGLE_CLIENT_ID=google_client_id_xxx

# --- Admin seed (pnpm db:seed-admin) ---
ADMIN_EMAIL=admin@onemorerip.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin

# --- Web (Vite — must be prefixed with VITE_) ---
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=google_client_id_xxx
# CloudFront (or S3) public base URL for product images
VITE_ASSET_CDN_URL=https://your-distribution.cloudfront.net
# CARTO basemap API key (Contact + order maps). Set on the Railway web service.
VITE_CARTO_API_KEY=
# Optional Plausible analytics domain. Script loads only after analytics cookie consent.
# VITE_PLAUSIBLE_DOMAIN=www.onemorerip.cards

# --- AWS S3 (server-side only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET=onemorerip-assets
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net
