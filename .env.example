# ─────────────────────────────────────────────────────────────
# One More Rip — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase Postgres) ---
# Transaction pooler — API runtime (port 6543, ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Session/direct pooler — Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=use-a-long-random-string-in-production

# Stripe secret key (server-side). Must start with sk_test_ or sk_live_.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret (whsec_...). From `stripe listen` or dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/cart

# --- Email (Resend) ---
# Create a key at https://resend.com — must start with re_
# Without a real key the API runs in mock mode (logs emails to the console).
RESEND_API_KEY=re_xxx
# After you verify onemorerip.cards in Resend, switch FROM to your domain:
# EMAIL_FROM=One More Rip <noreply@onemorerip.cards>
EMAIL_FROM=One More Rip <onboarding@resend.dev>
EMAIL_CONTACT_INBOX=contact@onemorerip.cards

# --- Google Sign-In (optional) ---
# Create an OAuth Client ID (Web) in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 and your production domain.
# Use the same Client ID on API + web.
GOOGLE_CLIENT_ID=google_client_id_xxx

# --- Admin seed (pnpm db:seed-admin) ---
ADMIN_EMAIL=admin@onemorerip.local
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Admin

# --- Web (Vite — must be prefixed with VITE_) ---
VITE_API_URL=http://localhost:4000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
VITE_GOOGLE_CLIENT_ID=google_client_id_xxx
# CloudFront (or S3) public base URL for product images
VITE_ASSET_CDN_URL=https://your-distribution.cloudfront.net

# --- AWS S3 (server-side only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_BUCKET=onemorerip-assets
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net
