# ─────────────────────────────────────────────────────────────
# akkNERDS — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- API (apps/api) ---
# Server port
PORT=4000
# Comma-separated list of allowed CORS origins (the web app)
WEB_ORIGIN=http://localhost:5173
# Secret used to sign JWT auth tokens (use a long random string in production)
JWT_SECRET=dev-super-secret-change-me-in-production

# Stripe secret key (server-side). Use a test key (sk_test_...) for development.
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret (whsec_...). From `stripe listen` or dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe redirects after checkout (the web app origin)
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/cart

# --- Web (apps/web) — must be prefixed with VITE_ to be exposed to the client ---
VITE_API_URL=http://localhost:4000
# Stripe publishable key (safe to expose). Use a test key (pk_test_...).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
